.post-card {
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 28rpx;
  border: 0;
  border-bottom: 1rpx solid #e4e8ef;
  border-radius: 0;
  background: #ffffff;
  color: #20242c;
  line-height: 1.5;
  text-align: left;
}

.post-card::after {
  border: 0;
}

.post-card--anonymous {
  border-left: 6rpx solid #8a93a6;
  background: #f7f8fa;
}

.post-card--pressed {
  background: #f0f2f6;
}

.post-card--anonymous.post-card--pressed {
  background: #eceff3;
}

.post-card__header,
.author-line,
.context-line,
.post-flags,
.post-card__footer,
.video-preview {
  display: flex;
  align-items: center;
}

.post-card__header {
  gap: 16rpx;
}

.author-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #cdd8e9;
  border-radius: 50%;
  background: #e8eef8;
  color: #000b34;
  font-size: 26rpx;
  font-weight: 800;
}

.author-avatar--anonymous {
  border-color: #6b7280;
  background: #6b7280;
  color: #ffffff;
}

.author-copy {
  flex: 1;
  min-width: 0;
}

.author-line {
  flex-wrap: wrap;
  gap: 10rpx;
}

.author-name {
  overflow: hidden;
  color: #20242c;
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.verified-label {
  flex: 0 0 auto;
  color: #0a4db3;
  font-size: 22rpx;
  font-weight: 700;
}

.context-line {
  flex-wrap: wrap;
  margin-top: 4rpx;
  color: #687082;
  font-size: 23rpx;
}

.context-separator {
  margin: 0 10rpx;
}

.post-flags {
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.flag {
  padding: 4rpx 12rpx;
  border: 1rpx solid #d7dce5;
  border-radius: 6rpx;
  background: #f0f2f6;
  color: #596273;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.4;
}

.flag--pinned {
  border-color: #f2c8a5;
  background: #fff4e8;
  color: #8a420b;
}

.flag--video {
  border-color: #cbdaf0;
  background: #e8eef8;
  color: #0a4db3;
}

.post-card__title,
.post-card__excerpt {
  display: block;
}

.post-card__title {
  margin-top: 20rpx;
  color: #171b24;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.42;
  word-break: break-word;
}

.post-card__excerpt {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: #3f4754;
  font-size: 28rpx;
  line-height: 1.68;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
}

.media-preview {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 280rpx;
  margin-top: 22rpx;
  border: 1rpx solid #dfe3ea;
  border-radius: 8rpx;
  background: #f0f2f6;
}

.media-preview__image {
  display: block;
  width: 100%;
  height: 100%;
}

.media-preview__label {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  padding: 7rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(0, 11, 52, 0.88);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
}

.video-preview {
  justify-content: center;
  gap: 14rpx;
  min-height: 176rpx;
  margin-top: 22rpx;
  border: 1rpx solid #d4dbe6;
  border-radius: 8rpx;
  background: #11182a;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
}

.video-preview__play {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 50%;
}

.video-preview__triangle {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 12rpx solid transparent;
  border-bottom: 12rpx solid transparent;
  border-left: 18rpx solid #ffffff;
}

.post-card__footer {
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f4;
  color: #687082;
  font-size: 24rpx;
}

.read-more {
  color: #0a4db3;
  font-weight: 700;
}
