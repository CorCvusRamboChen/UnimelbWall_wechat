<view class="page-shell detail-page">
  <view wx:if="{{loading && !post}}" class="detail-surface loading-card" aria-label="正在加载帖子详情">
    <view class="loading-author">
      <view class="loading-line loading-line--avatar"></view>
      <view class="loading-author__copy">
        <view class="loading-line loading-line--short"></view>
        <view class="loading-line loading-line--meta"></view>
      </view>
    </view>
    <view class="loading-line loading-line--title"></view>
    <view class="loading-line"></view>
    <view class="loading-line"></view>
  </view>

  <view wx:elif="{{error}}" class="status-card">
    <text class="status-title">{{error}}</text>
    <text class="muted">可以检查网络后重新加载。</text>
    <button class="primary-button" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:elif="{{post}}" class="detail-surface">
    <view class="detail-author">
      <view class="detail-avatar {{post.is_anonymous ? 'detail-avatar--anonymous' : ''}}" aria-hidden="true">
        {{post.author_initial}}
      </view>
      <view class="detail-author__copy">
        <view class="detail-author__line">
          <text class="detail-author__name">{{post.is_anonymous ? '匿名用户' : (post.author.display_name || '匿名用户')}}</text>
          <text wx:if="{{!post.is_anonymous && post.author.verified}}" class="verified-label">已认证</text>
        </view>
        <view class="detail-context">
          <text>{{post.category.name || '未分类'}}</text>
          <text class="context-separator">·</text>
          <text>{{post.published_at_text}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{post.is_pinned || post.is_anonymous || post.has_video}}" class="detail-flags">
      <text wx:if="{{post.is_pinned}}" class="detail-flag detail-flag--pinned">置顶</text>
      <text wx:if="{{post.is_anonymous}}" class="detail-flag">匿名发布</text>
      <text wx:if="{{post.has_video}}" class="detail-flag detail-flag--video">包含视频</text>
    </view>

    <text class="detail-title">{{post.title || '无标题帖子'}}</text>
    <text class="post-body" user-select="true">{{post.body}}</text>

    <view wx:if="{{post.media.length}}" class="media-list" aria-label="帖子媒体">
      <block wx:for="{{post.media}}" wx:key="id">
        <video
          wx:if="{{item.type === 'video'}}"
          class="post-video"
          src="{{item.file_id}}"
          controls
          show-center-play-btn
          object-fit="contain"
          title="{{item.alt || '帖子视频'}}"
        />
        <image
          wx:else
          class="post-media-image"
          src="{{item.file_id}}"
          mode="widthFix"
          lazy-load="true"
          aria-label="{{item.alt || '帖子图片'}}"
          data-file-id="{{item.file_id}}"
          bindtap="previewImage"
        />
      </block>
    </view>

    <view class="readonly-note">
      <text class="readonly-note__title">原帖共有 {{post.comment_count || 0}} 条评论</text>
      <text class="readonly-note__copy">当前版本仅提供公开帖子内容的只读浏览，暂不展示或参与互动。</text>
    </view>

    <view wx:if="{{post.updated_at_text}}" class="updated-line">
      最近更新：{{post.updated_at_text}}
    </view>
  </view>
</view>
