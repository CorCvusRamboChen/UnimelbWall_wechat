<view class="page-shell feed-page">
  <view class="brand-panel">
    <view class="brand-lockup">
      <view class="brand-mark" aria-hidden="true">墨</view>
      <view class="brand-copy">
        <text class="brand-title">墨大墙</text>
        <text class="brand-subtitle">UNIMELB WALL</text>
      </view>
    </view>
    <button class="about-button" bindtap="openAbout" aria-label="查看关于与同步状态">关于</button>
  </view>

  <view class="mirror-bar">
    <view class="mirror-identity">
      <view class="mirror-dot {{syncStatus === 'degraded' || syncStatus === 'unhealthy' ? 'mirror-dot--warning' : ''}}"></view>
      <text>公开帖子只读镜像</text>
    </view>
    <text wx:if="{{lastSyncedAtText}}" class="mirror-time">更新于 {{lastSyncedAtText}}</text>
    <text wx:else class="mirror-time">正在读取同步状态</text>
  </view>

  <view wx:if="{{syncStatus === 'degraded' || syncStatus === 'unhealthy'}}" class="sync-warning">
    <text class="sync-warning__title">内容更新暂时延迟</text>
    <text class="sync-warning__copy">当前仍可浏览最近一次成功同步的数据。</text>
  </view>

  <scroll-view class="category-scroll" scroll-x="true" enhanced="true" show-scrollbar="false" aria-label="帖子分类">
    <view class="category-row">
      <button
        wx:for="{{categories}}"
        wx:key="id"
        class="category-button {{selectedCategoryId === item.id ? 'category-button--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCategoryTap"
        aria-label="查看{{item.name}}分类"
      >{{item.name}}</button>
    </view>
  </scroll-view>

  <view wx:if="{{initialLoading && items.length === 0}}" class="feed-surface skeleton-list" aria-label="正在加载帖子">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="skeleton-card">
      <view class="skeleton-author">
        <view class="skeleton skeleton--avatar"></view>
        <view class="skeleton-author__copy">
          <view class="skeleton skeleton--short"></view>
          <view class="skeleton skeleton--meta"></view>
        </view>
      </view>
      <view class="skeleton skeleton--title"></view>
      <view class="skeleton"></view>
      <view class="skeleton skeleton--medium"></view>
    </view>
  </view>

  <view wx:elif="{{error && items.length === 0}}" class="status-card">
    <text class="status-title">暂时无法加载帖子</text>
    <text class="muted">{{error}}</text>
    <button class="primary-button" bindtap="onRetry">重新加载</button>
  </view>

  <view wx:elif="{{!initialLoading && items.length === 0}}" class="status-card">
    <text class="status-title">这里暂时没有公开帖子</text>
    <text class="muted">可以切换分类，或下拉刷新后再看看。</text>
  </view>

  <view wx:else class="feed-surface post-list">
    <post-card
      wx:for="{{items}}"
      wx:key="id"
      post="{{item}}"
      bind:select="onPostSelect"
    />
  </view>

  <view wx:if="{{loadingMore}}" class="footer-state">正在加载更多帖子…</view>
  <view wx:elif="{{items.length > 0 && !hasMore}}" class="footer-state">已显示全部公开帖子</view>
</view>
