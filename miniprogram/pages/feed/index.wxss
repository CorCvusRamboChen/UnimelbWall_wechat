.feed-page {
  padding-top: 32rpx;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 28rpx;
  margin-bottom: 28rpx;
  padding: 34rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #15386e 0%, #1d5fd1 70%, #3e7ee5 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(29, 95, 209, 0.2);
}

.hero__eyebrow,
.hero__title,
.hero__subtitle {
  display: block;
}

.hero__eyebrow {
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero__title {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.hero__subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

.about-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-family: serif;
  font-size: 30rpx;
}

.about-button::after,
.category-pill::after {
  border: 0;
}

.sync-warning {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #f2c38e;
  border-radius: 18rpx;
  background: #fff8ed;
  color: #995300;
  font-size: 24rpx;
}

.category-scroll {
  width: 100%;
  margin-bottom: 14rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 2rpx 2rpx 10rpx;
}

.category-pill {
  flex: 0 0 auto;
  min-height: 64rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid #dfe5ed;
  border-radius: 999rpx;
  background: #ffffff;
  color: #536377;
  font-size: 25rpx;
  line-height: 64rpx;
}

.category-pill--active {
  border-color: #1d5fd1;
  background: #1d5fd1;
  color: #ffffff;
}

.sync-line,
.footer-state {
  color: #8592a3;
  font-size: 23rpx;
  text-align: center;
}

.sync-line {
  margin-bottom: 20rpx;
  text-align: left;
}

.footer-state {
  padding: 24rpx 0 44rpx;
}

.skeleton-card {
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.skeleton {
  height: 24rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #edf0f4 25%, #f7f8fa 50%, #edf0f4 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite linear;
}

.skeleton--short {
  width: 24%;
  margin-top: 0;
}

.skeleton--title {
  width: 72%;
  height: 34rpx;
}

.skeleton--medium {
  width: 58%;
}

@keyframes shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}
