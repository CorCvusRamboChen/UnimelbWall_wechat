.feed-page {
  padding-top: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.brand-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #000927;
  border-radius: 16rpx;
  background: #000b34;
  color: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(0, 11, 52, 0.16);
}

.brand-lockup,
.mirror-bar,
.mirror-identity,
.skeleton-author {
  display: flex;
  align-items: center;
}

.brand-lockup {
  min-width: 0;
  gap: 20rpx;
}

.brand-mark {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 8rpx;
  color: #ffffff;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 42rpx;
  font-weight: 700;
}

.brand-title,
.brand-subtitle,
.sync-warning__title,
.sync-warning__copy {
  display: block;
}

.brand-title {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
}

.brand-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.about-button {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
}

.about-button::after,
.category-button::after {
  border: 0;
}

.about-button.button-hover {
  background: rgba(255, 255, 255, 0.2);
}

.mirror-bar {
  justify-content: space-between;
  gap: 20rpx;
  min-height: 80rpx;
  padding: 0 4rpx;
  color: #4f5969;
  font-size: 24rpx;
}

.mirror-identity {
  flex: 0 0 auto;
  gap: 12rpx;
  color: #20242c;
  font-weight: 700;
}

.mirror-dot {
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #dce6f8;
  border-radius: 50%;
  background: #0a4db3;
}

.mirror-dot--warning {
  border-color: #ffe1b9;
  background: #8a4b08;
}

.mirror-time {
  overflow: hidden;
  color: #687082;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-warning {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #8a4b08;
  border-radius: 8rpx;
  background: #fff4e5;
}

.sync-warning__title {
  color: #6e3a05;
  font-size: 26rpx;
  font-weight: 700;
}

.sync-warning__copy {
  margin-top: 6rpx;
  color: #76491d;
  font-size: 24rpx;
}

.category-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
  padding: 0 2rpx 8rpx;
}

.category-button {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid #d7dce5;
  border-radius: 8rpx;
  background: #ffffff;
  color: #4f5969;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.category-button--active {
  border-color: #000b34;
  background: #e8eef8;
  color: #000b34;
  font-weight: 800;
}

.category-button.button-hover {
  background: #f0f2f6;
}

.category-button--active.button-hover {
  background: #dce6f6;
}

.feed-surface {
  overflow: hidden;
  border: 1rpx solid #dfe3ea;
  border-radius: 12rpx;
  background: #ffffff;
}

.post-list post-card {
  display: block;
}

.skeleton-card {
  padding: 28rpx;
  border-bottom: 1rpx solid #e4e8ef;
}

.skeleton-card:last-child {
  border-bottom: 0;
}

.skeleton-author {
  gap: 16rpx;
}

.skeleton-author__copy {
  flex: 1;
}

.skeleton {
  height: 24rpx;
  margin-top: 18rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #edf0f4 25%, #f8f9fb 50%, #edf0f4 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite linear;
}

.skeleton--avatar {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  margin-top: 0;
  border-radius: 50%;
}

.skeleton--short {
  width: 28%;
  margin-top: 0;
}

.skeleton--meta {
  width: 42%;
  height: 18rpx;
  margin-top: 10rpx;
}

.skeleton--title {
  width: 72%;
  height: 34rpx;
  margin-top: 28rpx;
}

.skeleton--medium {
  width: 58%;
}

.footer-state {
  padding: 32rpx 0 16rpx;
  color: #687082;
  font-size: 24rpx;
  text-align: center;
}

@keyframes shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton {
    animation: none;
  }
}

@media (min-width: 768px) {
  .feed-page {
    padding-top: 32rpx;
  }

  .brand-panel {
    padding: 32rpx 36rpx;
  }
}
